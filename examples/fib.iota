;; Fibonacci two ways. Exact integers have no size limit, and
;; (scheme time) measures how much slower the naive version is.
;;
;; The timing goes to the error port. Standard output is then the same
;; on every run, and `iota examples/fib.iota 2>/dev/null` hides it.

(import (scheme base) (scheme write) (scheme time))

;; Two recursive calls per step: exponential time.
(define (fib-slow n)
  (if (< n 2) n (+ (fib-slow (- n 1)) (fib-slow (- n 2)))))

;; A named let that carries the last two values: linear time, and a
;; tail call, so it runs in constant space.
(define (fib n)
  (let loop ((a 0) (b 1) (n n))
    (if (= n 0) a (loop b (+ a b) (- n 1)))))

;; Call thunk, report how long it took on the error port, return its
;; result. current-jiffy counts in units of 1/(jiffies-per-second).
(define (timed label thunk)
  (let* ((start (current-jiffy))
         (result (thunk))
         (elapsed (/ (- (current-jiffy) start) (jiffies-per-second)))
         (err (current-error-port)))
    (display label err)
    (display " took " err)
    (display (inexact elapsed) err)
    (display "s" err)
    (newline err)
    result))

(display "(fib 100) = ")
(display (fib 100))
(newline)

(display "(fib-slow 20) = ")
(display (timed "(fib-slow 20)" (lambda () (fib-slow 20))))
(newline)

(display "(fib 20) = ")
(display (timed "(fib 20)" (lambda () (fib 20))))
(newline)
