;; Records with define-record-type: a constructor, a predicate,
;; accessors and a modifier.

(import (scheme base) (scheme inexact) (scheme write))

(define (show . xs)
  (for-each display xs)
  (newline))

;; The constructor takes x and y. Only x can be changed afterwards,
;; because only x has a modifier.
(define-record-type point
  (make-point x y)
  point?
  (x point-x set-point-x!)
  (y point-y))

(define p (make-point 3 4))

(show "p is " p)
(show "x = " (point-x p) ", y = " (point-y p))

(set-point-x! p 10)
(show "after set-point-x!: " p)

;; Every record type is distinct from every other type.
(show "(point? p) = " (point? p))
(show "(point? 5) = " (point? 5))
(show "(vector? p) = " (vector? p))

;; An accessor refuses anything that is not a point.
(guard (e ((error-object? e)
           (show "error: " (error-object-message e)
                 " " (error-object-irritants e))))
  (point-x 'not-a-point))

;; Records are compared by identity. Two points with the same fields
;; are not equal?, so write your own comparison.
(define (point=? a b)
  (and (= (point-x a) (point-x b))
       (= (point-y a) (point-y b))))

(define q (make-point 10 4))
(show "(equal? p q) = " (equal? p q))
(show "(point=? p q) = " (point=? p q))

;; A procedure over records.
(define (distance a b)
  (let ((dx (- (point-x a) (point-x b)))
        (dy (- (point-y a) (point-y b))))
    (sqrt (+ (* dx dx) (* dy dy)))))

(show "distance = " (distance (make-point 0 0) (make-point 3 4)))
