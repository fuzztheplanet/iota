cabal-version:      3.4
name:               iota
version:            0.1
synopsis:           A small R7RS Scheme interpreter in Haskell
description:
  iota is an R7RS-small Scheme interpreter. Linux only. It is built as a
  library (the Iota.* modules) with a small command line driver on top, so
  the reader, the printer, the expander and the evaluator can each be
  tested on their own.

  A Haskell program that runs Scheme with iota needs the module "Iota" and
  no other. Its header has a complete example. The other modules are the
  parts of the interpreter.

  The documentation is at <https://fuzztheplanet.github.io/iota/>: the
  user's guide, the libraries and procedures, the R7RS coverage table and
  notes on how the interpreter is put together.

homepage:           https://github.com/fuzztheplanet/iota
bug-reports:        https://github.com/fuzztheplanet/iota/issues
license:            MIT
license-file:       LICENSE
author:             Skywhi
maintainer:         skywhi@skywhi.net
copyright:          (c) 2026 Skywhi
category:           Language
build-type:         Simple
extra-doc-files:    README.org
                    CHANGELOG.org
                    examples/README.org
                    docs/index.org
                    docs/setup.org
                    docs/install.org
                    docs/tutorial.org
                    docs/examples.org
                    docs/guide.org
                    docs/procedures.org
                    docs/r7rs-coverage.org
                    docs/architecture.org
                    docs/hacking.org
tested-with:        GHC == 9.4.8, GHC == 9.6.7, GHC == 9.8.2

-- The test suite reads the pages above and the example programs, so they
-- all have to be in the source distribution.
extra-source-files: lib/iota/stdlib.iota
                    Makefile
                    docs/Makefile
                    docs/export.el
                    examples/*.iota
                    examples/my/*.iota
                    examples/haskell/Embed.expected
                    test/scheme/*.iota
                    test/scheme/lib/*.iota
                    test/golden/*.golden
                    test/golden/examples/*.golden
                    test/conformance/README.org
                    test/conformance/run.sh
                    test/conformance/expected-failures.txt
                    test/conformance/chibi/*.iota

source-repository head
  type:     git
  location: https://github.com/fuzztheplanet/iota.git

-- Keep the warnings on. A lot of the interpreter relies on GHC telling me
-- when a pattern match has stopped being exhaustive.
common warnings
  ghc-options:      -Wall
                    -Wcompat
                    -Widentities
                    -Wincomplete-record-updates
                    -Wincomplete-uni-patterns
                    -Wmissing-export-lists
                    -Wpartial-fields
                    -Wredundant-constraints

common language
  default-language: GHC2021
  default-extensions:
                    DerivingStrategies
                    LambdaCase
                    MultiWayIf
                    OverloadedStrings
                    RecordWildCards

library
  import:           warnings, language
  hs-source-dirs:   src
  exposed-modules:  Iota
                    Iota.CLI
                    Iota.Counter
                    Iota.Eval
                    Iota.Expand
                    Iota.Expand.Common
                    Iota.Expand.Derived
                    Iota.Expand.Library
                    Iota.Interpreter
                    Iota.Library
                    Iota.Number
                    Iota.Primitives
                    Iota.Primitives.Control
                    Iota.Primitives.IO
                    Iota.Primitives.Numeric
                    Iota.Primitives.Pairs
                    Iota.Primitives.Predicates
                    Iota.Primitives.Strings
                    Iota.Primitives.Vectors
                    Iota.Printer
                    Iota.Reader
                    Iota.Repl
                    Iota.Syntax
                    Iota.SyntaxRules
                    Iota.Types
                    Iota.Value
  other-modules:    Paths_iota
  autogen-modules:  Paths_iota
  build-depends:    base                 >= 4.16   && < 5
                  , bytestring           >= 0.11   && < 0.13
                  , containers           >= 0.6    && < 0.8
                  , directory            >= 1.3    && < 1.4
                  , file-embed           >= 0.0.15 && < 0.1
                  , filepath             >= 1.4    && < 1.6
                  , haskeline            >= 0.8    && < 0.9
                  , megaparsec           >= 9.2    && < 10
                  , optparse-applicative >= 0.17   && < 0.20
                  , text                 >= 1.2    && < 2.2
                  , time                 >= 1.9    && < 1.15
                  , transformers         >= 0.5    && < 0.7
                  , vector               >= 0.12   && < 0.14

executable iota
  import:           warnings, language
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base
                  , iota
  ghc-options:      -threaded -rtsopts -with-rtsopts=-K256m

test-suite iota-test
  import:           warnings, language
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Test.CLI
                    Test.Coverage
                    Test.Docs
                    Test.Eval
                    Test.Examples
                    Test.Golden
                    Test.Macro
                    Test.Number
                    Test.Ports
                    Test.Property
                    Test.Printer
                    Test.Reader
                    Test.Scheme
                    Test.Util
  build-depends:    base
                  , iota
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , optparse-applicative
                  , QuickCheck           >= 2.14   && < 2.16
                  , tasty                >= 1.4    && < 1.6
                  , tasty-golden         >= 2.3    && < 2.4
                  , tasty-hunit          >= 0.10   && < 0.11
                  , tasty-quickcheck     >= 0.10   && < 0.12
                  , text
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- The program in examples/haskell, built and run so that the example of
-- using iota from Haskell keeps compiling and keeps printing what the
-- documentation says. It takes none of the shared settings above: it is
-- plain Haskell 2010, built the way a program outside this package is.
test-suite iota-embed-example
  import:           warnings
  type:             exitcode-stdio-1.0
  default-language: Haskell2010
  hs-source-dirs:   test/embed, examples/haskell
  main-is:          Main.hs
  other-modules:    Embed
  build-depends:    base
                  , iota
                  , directory
                  , text
